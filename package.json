    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@types/express-session": "^1.18.2",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "express": "^5.0.1",
    "express-session": "^1.19.0",
    "memorystore": "^1.6.7",
    "pg": "^8.16.3",
    "ssh2": "^1.17.0",
    "tsx": "^4.20.6",
    "twilio": "^5.3.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "tweetsodium": "^0.0.4",
    "typescript": "~5.9.2"
  },
